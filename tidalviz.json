      "renderer": "webgl2",
      "params": [
        { "id": "stars", "type": "number", "label": "Stars", "min": 0, "max": 400, "step": 10, "default": 280 },
        { "id": "dynamics", "type": "number", "label": "Dynamics", "min": 0, "max": 1, "step": 0.05, "default": 0.45 },
        { "id": "shimmer", "type": "number", "label": "Shimmer", "min": 0, "max": 2, "step": 0.05, "default": 0.7 },
