        { "id": "response", "type": "select", "label": "Response", "options": [ "auto", "beats", "flowing" ], "default": "auto" },
        { "id": "pulse", "type": "number", "label": "Core pulse", "min": 0, "max": 2, "step": 0.05, "default": 0.5 },
        { "id": "pulseDecay", "type": "number", "label": "Pulse decay (s)", "min": 0.05, "max": 1, "step": 0.01, "default": 0.45 },
        { "id": "kickThreshold", "type": "number", "label": "Kick threshold", "min": 1.1, "max": 3, "step": 0.05, "default": 1.5 },
        { "id": "speed", "type": "number", "label": "Drift speed", "min": 0, "max": 3, "step": 0.05, "default": 0 },
        { "id": "nebula", "type": "number", "label": "Brightness", "min": 0.3, "max": 1.6, "step": 0.05, "default": 1 },
        { "id": "fit", "type": "select", "label": "Fit", "options": [ "whole image", "fill screen" ], "default": "whole image" },
        { "id": "zoom", "type": "number", "label": "Zoom", "min": 0.6, "max": 2, "step": 0.01, "default": 1 },
        { "id": "coreX", "type": "number", "label": "Core position X", "min": 0, "max": 1, "step": 0.01, "default": 0.57 },
        { "id": "coreY", "type": "number", "label": "Core position Y", "min": 0, "max": 1, "step": 0.01, "default": 0.53 }
