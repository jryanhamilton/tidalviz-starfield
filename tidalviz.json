{
  "apiVersion": 1,
  "visualizers": [
    {
      "id": "starfield",
      "name": "Starfield",
      "description": "Fly through stars toward a nebula lit from within: each star listens to its own frequency, beats flare a handful, the bass sets the speed, and kicks pulse the core.",
      "author": "Tidalviz",
      "entry": "src/main.js",
      "renderer": "webgl2",
      "params": [
        { "id": "speed", "type": "number", "label": "Speed", "min": 0, "max": 3, "step": 0.05, "default": 1 },
        { "id": "density", "type": "number", "label": "Star density", "min": 0.02, "max": 0.6, "step": 0.01, "default": 0.15 },
        { "id": "dynamics", "type": "number", "label": "Dynamics", "min": 0, "max": 1, "step": 0.05, "default": 0.8 },
        { "id": "shimmer", "type": "number", "label": "Shimmer", "min": 0, "max": 2, "step": 0.05, "default": 1 },
        { "id": "twinkle", "type": "number", "label": "Twinkle", "min": 0, "max": 1, "step": 0.05, "default": 0.5 },
        { "id": "twinkleSync", "type": "select", "label": "Twinkle timing", "options": [ "free", "auto", "tempo" ], "default": "free" },
        { "id": "twinkleSpeed", "type": "number", "label": "Twinkle speed (free)", "min": 0, "max": 3, "step": 0.05, "default": 1 },
        { "id": "flares", "type": "number", "label": "Beat flares", "min": 0, "max": 0.6, "step": 0.01, "default": 0.2 },
        { "id": "flaresOn", "type": "select", "label": "Flares on", "options": [ "all beats", "kicks" ], "default": "all beats" },
        { "id": "response", "type": "select", "label": "Response", "options": [ "auto", "beats", "flowing" ], "default": "auto" },
        { "id": "pulse", "type": "number", "label": "Core pulse", "min": 0, "max": 2, "step": 0.05, "default": 1 },
        { "id": "pulseDecay", "type": "number", "label": "Pulse decay (s)", "min": 0.05, "max": 1, "step": 0.01, "default": 0.25 },
        { "id": "kickThreshold", "type": "number", "label": "Kick threshold", "min": 1.1, "max": 3, "step": 0.05, "default": 1.5 },
        { "id": "nebula", "type": "number", "label": "Nebula", "min": 0, "max": 2, "step": 0.05, "default": 1 },
        { "id": "size", "type": "number", "label": "Nebula size", "min": 0.4, "max": 1.2, "step": 0.01, "default": 0.72 },
        { "id": "core", "type": "color", "label": "Core light", "default": "#3fb4ff" },
        { "id": "gas", "type": "color", "label": "Gas", "default": "#2c52a8" },
        { "id": "rim", "type": "color", "label": "Rim light", "default": "#f0b496" }
      ]
    },
    {
      "id": "aogm-imagine-nebula-3a",
      "name": "aogm-imagine-nebula-3a",
      "description": "A teal sky breaking open between dark cloud banks, from Nebulae III by Greg Martin (artofgregmartin.com/imagine/nebulae-iii; free for personal use, not included: see the plugin README). The core pulses with the music and the painted stars shimmer, twinkle and flare in place.",
